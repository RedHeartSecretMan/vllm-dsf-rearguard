{
  "model": "deepseek-ai/DeepSeek-V4.1-Flash-1017",
  "runner": "scripts.acceptance.visual",
  "description": "GPU endpoint cases with generated numbered media, exact output assertions and saved request/response evidence. Processor and scheduler boundary assertions are separate runtime checks.",
  "limits": {
    "max_images_per_request": 64,
    "max_videos_per_request": 2,
    "max_frames_per_video": 32,
    "default_fps": 1
  },
  "cases": [
    {"id": "visual-image-single", "kind": "image", "images": 1},
    {"id": "visual-image-multiple", "kind": "image", "images": 4},
    {"id": "visual-image-limit-64", "kind": "image", "images": 64},
    {"id": "visual-video-short", "kind": "video", "videos": 1, "fixtures": ["short"], "max_frames": 32},
    {"id": "visual-video-long", "kind": "video", "videos": 1, "fixtures": ["long"], "max_frames": 32, "fps": 1},
    {"id": "visual-video-two-items", "kind": "video", "videos": 2, "fixtures": ["short", "second"], "max_frames": 32},
    {"id": "visual-image-video-image-order", "kind": "mixed", "images": 2, "videos": 1, "fixtures": ["short"]},
    {"id": "visual-video-chunked-disabled", "kind": "video", "fixtures": ["long"], "launch_arg": "--disable-chunked-mm-input"},
    {"id": "visual-video-chunked-frame-boundary", "kind": "video", "fixtures": ["long"], "launch_arg": "--no-disable-chunked-mm-input", "compare_with": "visual-video-chunked-disabled"},
    {"id": "visual-video-history-uuid", "kind": "video_history", "fixtures": ["short"], "requires": ["server-generated stable video_id", "two real turns", "unchanged replayed media"]}
  ]
}

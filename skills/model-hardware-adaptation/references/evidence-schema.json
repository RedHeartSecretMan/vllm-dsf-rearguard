{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RedHeartSecretMan/vllm-dsf-rearguard/skills/model-hardware-adaptation/references/evidence-schema.json",
  "title": "vLLM model hardware adaptation evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "evidence_class",
    "scope",
    "stage",
    "gate",
    "protocol",
    "source_revision",
    "workspace_state",
    "image_digest",
    "model_revision",
    "model_files",
    "adaptation_manifest_sha256",
    "hardware",
    "driver",
    "cuda",
    "framework_versions",
    "parallelism",
    "launch_args_sha256",
    "test_config_sha256",
    "started_at",
    "finished_at",
    "status",
    "failure",
    "metrics",
    "artifacts",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "evidence_class": {
      "type": "string",
      "enum": ["current", "historical", "assumption"]
    },
    "scope": {
      "type": "string",
      "enum": ["general", "model_hardware_specific"]
    },
    "stage": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-4])$"
    },
    "gate": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "string",
      "enum": ["chat-completions", "responses", "other", "not-applicable"]
    },
    "source_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{7,40}|WORKTREE)$"
    },
    "workspace_state": {
      "type": "string",
      "enum": ["clean", "dirty-classified", "dirty-unclassified", "unknown"]
    },
    "image_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model_revision": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "model_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "adaptation_manifest_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu", "count", "memory_gib_per_gpu", "compute_capability", "topology"],
      "properties": {
        "gpu": {
          "type": ["string", "null"]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "memory_gib_per_gpu": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "compute_capability": {
          "type": ["string", "null"]
        },
        "topology": {
          "type": ["string", "null"]
        }
      }
    },
    "driver": {
      "type": ["string", "null"]
    },
    "cuda": {
      "type": ["string", "null"]
    },
    "framework_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pytorch", "vllm", "compiler"],
      "properties": {
        "pytorch": {
          "type": ["string", "null"]
        },
        "vllm": {
          "type": ["string", "null"]
        },
        "compiler": {
          "type": ["string", "null"]
        }
      }
    },
    "parallelism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tp", "dp", "ep", "eplb", "communication_backend", "speculative"],
      "properties": {
        "tp": {
          "type": "integer",
          "minimum": 0
        },
        "dp": {
          "type": "integer",
          "minimum": 0
        },
        "ep": {
          "type": "integer",
          "minimum": 0
        },
        "eplb": {
          "type": ["boolean", "null"]
        },
        "communication_backend": {
          "type": ["string", "null"]
        },
        "speculative": {
          "type": ["string", "null"]
        }
      }
    },
    "launch_args_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_config_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "SKIP", "NA", "NOT_RUN"]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "layer", "first_trusted_error", "reproduction", "next_action", "root_cause_status"],
      "properties": {
        "class": {
          "type": ["string", "null"]
        },
        "layer": {
          "type": ["string", "null"]
        },
        "first_trusted_error": {
          "type": ["string", "null"]
        },
        "reproduction": {
          "type": ["string", "null"]
        },
        "next_action": {
          "type": ["string", "null"]
        },
        "root_cause_status": {
          "type": "string",
          "enum": ["resolved", "unresolved", "not_applicable"]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "input_tps",
        "output_tps",
        "total_tps",
        "ttft_p50_s",
        "ttft_p95_s",
        "tpot_p95_ms",
        "itl_p95_ms",
        "e2e_p95_s",
        "gpu_memory_gib",
        "kv_capacity_tokens",
        "kv_usage",
        "queue_time_s",
        "successful_requests",
        "failed_requests"
      ],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_tokens": {"type": ["integer", "null"], "minimum": 0},
        "input_tps": {"type": ["number", "null"], "minimum": 0},
        "output_tps": {"type": ["number", "null"], "minimum": 0},
        "total_tps": {"type": ["number", "null"], "minimum": 0},
        "ttft_p50_s": {"type": ["number", "null"], "minimum": 0},
        "ttft_p95_s": {"type": ["number", "null"], "minimum": 0},
        "tpot_p95_ms": {"type": ["number", "null"], "minimum": 0},
        "itl_p95_ms": {"type": ["number", "null"], "minimum": 0},
        "e2e_p95_s": {"type": ["number", "null"], "minimum": 0},
        "gpu_memory_gib": {"type": ["number", "null"], "minimum": 0},
        "kv_capacity_tokens": {"type": ["integer", "null"], "minimum": 0},
        "kv_usage": {"type": ["number", "null"], "minimum": 0},
        "queue_time_s": {"type": ["number", "null"], "minimum": 0},
        "successful_requests": {"type": "integer", "minimum": 0},
        "failed_requests": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "repetitions", "skipped_scope"],
      "properties": {
        "cases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "repetitions": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_scope": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
